# Copy this file to .env and fill in your values.

# ── Per-stage backends ────────────────────────────────────────────────────────
# Each stage names its own backend. The deprecated MOCK_MODE flag gated two
# unrelated stages at once and defaulted to on, which meant the pipeline
# silently ran word-overlap matching in place of NLI. Leave these at their
# defaults unless you specifically want a degraded run.
CLAIM_BACKEND=heuristic       # heuristic | llm | naive (regression tests only)
NLI_BACKEND=transformer       # transformer | lexical | off
EVIDENCE_BACKEND=live         # live | cache_only | mock
ENSEMBLE_BACKEND=real         # real | mock
OCR_BACKEND=tesseract         # tesseract | mock | off — see requirements.txt for the system-binary prerequisite
TRANSLATION_BACKEND=llm       # llm | indictrans2 (not yet implemented) | off

# ── NLI ───────────────────────────────────────────────────────────────────────
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
NLI_DEVICE=auto               # auto | cuda | cpu
NLI_FP16=true

# ── OCR ───────────────────────────────────────────────────────────────────────
OCR_LANGS=hin+eng             # Tesseract language codes, "+"-joined
OCR_CONFIDENCE_MIN=0.55       # below this, abstain rather than verify a bad transcription
OCR_MAX_IMAGE_MB=10.0

# ── Language ID ───────────────────────────────────────────────────────────────
LANG_ID_MIN_CONFIDENCE=0.5    # below this, treat the detected language as unknown

# ── Embeddings / evidence relevance gating ────────────────────────────────────
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RELEVANCE_MIN=0.45            # cosine floor for a snippet to count as evidence

# ── LLM (optional — claim extraction runs locally by default) ─────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
LLM_PROVIDER=anthropic        # anthropic | openai
LLM_MODEL=claude-haiku-4-5-20251001

# ── Search ────────────────────────────────────────────────────────────────────
NEWS_API_KEY=...              # newsapi.org — free tier, used for trusted-outlet search
TAVILY_API_KEY=tvly-...
SERPAPI_KEY=...
SEARCH_PROVIDER=newsapi       # newsapi | wikipedia | tavily | serpapi

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./paper_trail.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/paper_trail

# ── Evidence cache ────────────────────────────────────────────────────────────
# Makes verdicts reproducible and keeps NewsAPI's 100/day free tier from being
# the binding constraint. Set TTL to 0 for evaluation replays (never expire).
EVIDENCE_CACHE_DIR=cache/evidence
EVIDENCE_CACHE_TTL_DAYS=7

# ── Pipeline ──────────────────────────────────────────────────────────────────
MAX_EVIDENCE_CALLS=12
MAX_CLAIMS=5
CHECKWORTHY_MIN=0.35
RETRIEVAL_WORKERS=3
STAGE_TIMEOUT_S=90

# Abstention band. Overridden by the trained fusion model's own thresholds,
# which are chosen on held-out data to hold TARGET_PRECISION.
ESCALATION_LOW=0.4
ESCALATION_HIGH=0.6
TARGET_PRECISION=0.90

# ── Region-aware verification ─────────────────────────────────────────────────
# Detects the place a claim is about and adds regional news to its evidence.
# Free, no keys needed: Nominatim (OpenStreetMap) geocodes, Google News RSS
# provides regional headlines. Set REGION_AWARE=false to disable entirely.
REGION_AWARE=true
GEOCODER_BACKEND=nominatim            # nominatim | offline | off
LOCATION_MIN_CONFIDENCE=0.5
REGIONAL_NEWS_PROVIDER=gnews_rss      # gnews_rss | newsdata | none
NEWSDATA_API_KEY=...                  # optional, free tier at newsdata.io
REGION_MAX_QUERIES=3
REGION_MIN_SNIPPETS=2
REGION_MAX_EXTRA_SNIPPETS=2

# ── Claim mode (one or two sentences) ─────────────────────────────────────────
# Short inputs are decided on evidence alone; the article-trained style
# classifier is not used. Articles take the unchanged article path.
CLAIM_MODE=true
CLAIM_MODE_MAX_CHARS=300
CLAIM_MODE_MAX_SENTENCES=2
CLAIM_ENTAIL_MIN=0.45
CLAIM_CONTRADICT_MIN=0.5
