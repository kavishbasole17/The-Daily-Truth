# Copy this file to .env and fill in your values.

# ── Per-stage backends ────────────────────────────────────────────────────────
# Each stage names its own backend. The deprecated MOCK_MODE flag gated two
# unrelated stages at once and defaulted to on, which meant the pipeline
# silently ran word-overlap matching in place of NLI. Leave these at their
# defaults unless you specifically want a degraded run.
CLAIM_BACKEND=llm             # llm | heuristic | naive (regression tests only)
NLI_BACKEND=transformer       # transformer | lexical | off
EVIDENCE_BACKEND=live         # live | cache_only | mock
ENSEMBLE_BACKEND=real         # real | mock
OCR_BACKEND=tesseract         # tesseract | mock | off — see requirements.txt for the system-binary prerequisite
TRANSLATION_BACKEND=llm       # llm | indictrans2 (not yet implemented) | off

# ── NLI ───────────────────────────────────────────────────────────────────────
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
NLI_DEVICE=auto               # auto (cuda, then Apple mps, then cpu) | cuda | mps | cpu
NLI_FP16=true

# ── OCR ───────────────────────────────────────────────────────────────────────
OCR_LANGS=hin+eng             # Tesseract language codes, "+"-joined
OCR_CONFIDENCE_MIN=0.55       # below this, abstain rather than verify a bad transcription
OCR_MAX_IMAGE_MB=10.0

# ── Language ID ───────────────────────────────────────────────────────────────
LANG_ID_MIN_CONFIDENCE=0.5    # below this, treat the detected language as unknown

# ── Embeddings / evidence relevance gating ────────────────────────────────────
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
RELEVANCE_MIN=0.45            # cosine floor for a snippet to count as evidence

# ── LLM (optional — claim extraction runs locally by default) ─────────────────
ANTHROPIC_API_KEY=sk-ant-...          # REQUIRED for full accuracy: claim extraction, translation, chat
OPENAI_API_KEY=sk-...
LLM_PROVIDER=anthropic        # anthropic | openai | nvidia
LLM_MODEL=claude-opus-5-5

# NVIDIA API catalog (build.nvidia.com, free key starts with nvapi-).
# To use it, set LLM_PROVIDER=nvidia above. Claim extraction + translation then
# run on NVIDIA_LLM_MODEL and follow-up Q&A on NVIDIA_QA_MODEL. The independent
# LLM fact-check (LLM_JUDGE) and the chat tool loop still need Anthropic, so with
# LLM_PROVIDER=nvidia they fall back and show it as a degradation.
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b   # strongest reasoning model in the catalog: claims, translation
NVIDIA_QA_MODEL=deepseek-ai/deepseek-v4.1-flash      # fast and cheap on rate limits: follow-up answers

# ── Independent LLM fact-check (blended into the final verdict) ───────────────
# Runs concurrently with the agentic pipeline: Claude searches the live web for
# each key claim and returns its own P(real). The final verdict is a weighted
# blend of both; when the two checks commit to opposite verdicts the result is
# "uncertain" rather than a confident-looking average. Needs the key of
# LLM_JUDGE_PROVIDER (NVIDIA_API_KEY or ANTHROPIC_API_KEY). On NVIDIA it searches
# with Tavily when TAVILY_API_KEY is set, else Google News headlines.
LLM_JUDGE=true
LLM_JUDGE_WEIGHT=0.6          # share of the final score from the LLM check (pipeline gets the rest)
LLM_JUDGE_PROVIDER=           # nvidia | anthropic | empty = same as LLM_PROVIDER
NVIDIA_JUDGE_MODEL=nvidia/nemotron-3-ultra-550b-a55b  # judge model when the provider is nvidia
LLM_JUDGE_MODEL=claude-opus-5-5   # judge model when the provider is anthropic
LLM_JUDGE_WEB_SEARCH=true     # ground the check in live web search (recommended)
LLM_JUDGE_MAX_SEARCHES=8      # searches per check; the main cost and latency lever
LLM_JUDGE_TIMEOUT_S=240       # after this the pipeline verdict stands alone (recorded as a degradation)
LLM_JUDGE_MIN_CONFIDENCE=0.6  # a verdict the LLM reaches alone needs at least this self-reported confidence

# ── Search ────────────────────────────────────────────────────────────────────
NEWS_API_KEY=...              # newsapi.org — free tier, used for trusted-outlet search
TAVILY_API_KEY=tvly-...
SERPAPI_KEY=...
SEARCH_PROVIDER=newsapi       # newsapi | wikipedia | tavily | serpapi

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production
JWT_EXPIRE_MINUTES=1440
GUEST_QUERY_LIMIT=1           # verification queries allowed before sign-in is required
SEED_TEST_USER=true           # creates testuser / Test@1234 on startup
# Google sign-in (optional). OAuth 2.0 *Web* client ID from Google Cloud Console.
# Put the same value in frontend/.env.local as NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# ── Follow-up questions ───────────────────────────────────────────────────────
# Answered from a chat's evidence by the LLM_PROVIDER model below (needs that
# provider's API key above). Without a key, the most relevant evidence is shown.
QA_ENABLED=true
QA_MODEL=claude-opus-5-5

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./paper_trail.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/paper_trail

# ── Evidence cache ────────────────────────────────────────────────────────────
# Makes verdicts reproducible and keeps NewsAPI's 100/day free tier from being
# the binding constraint. Set TTL to 0 for evaluation replays (never expire).
EVIDENCE_CACHE_DIR=cache/evidence
EVIDENCE_CACHE_TTL_DAYS=7

# ── Pipeline ──────────────────────────────────────────────────────────────────
MAX_EVIDENCE_CALLS=12
MAX_CLAIMS=5
CHECKWORTHY_MIN=0.35
RETRIEVAL_WORKERS=3
STAGE_TIMEOUT_S=90
LLM_STAGE_TIMEOUT_S=300       # translation + LLM claim extraction (long articles take a while)

# Abstention band. Overridden by the trained fusion model's own thresholds,
# which are chosen on held-out data to hold TARGET_PRECISION.
ESCALATION_LOW=0.4
ESCALATION_HIGH=0.6
TARGET_PRECISION=0.90

# ── Region-aware verification ─────────────────────────────────────────────────
# Detects the place a claim is about and adds regional news to its evidence.
# Free, no keys needed: Nominatim (OpenStreetMap) geocodes, Google News RSS
# provides regional headlines. Set REGION_AWARE=false to disable entirely.
REGION_AWARE=true
GEOCODER_BACKEND=nominatim            # nominatim | offline | off
LOCATION_MIN_CONFIDENCE=0.5
REGIONAL_NEWS_PROVIDER=gnews_rss      # gnews_rss | newsdata | none
NEWSDATA_API_KEY=...                  # optional, free tier at newsdata.io
REGION_MAX_QUERIES=3
REGION_MIN_SNIPPETS=2
REGION_MAX_EXTRA_SNIPPETS=2

# ── Claim mode (one or two sentences) ─────────────────────────────────────────
# Short inputs are decided on evidence alone; the article-trained style
# classifier is not used. Articles take the unchanged article path.
CLAIM_MODE=true
CLAIM_MODE_MAX_CHARS=300
CLAIM_MODE_MAX_SENTENCES=2
CLAIM_ENTAIL_MIN=0.45
CLAIM_CONTRADICT_MIN=0.5

# ── Origin trail (report-only; never changes a verdict) ───────────────────────
# For claims the evidence does not support: who made the claim and the earliest
# source found repeating it. Fact-check lookup needs a free Google Fact Check
# Tools key (Google Cloud console → enable "Fact Check Tools API"); without one
# the trail is built from retrieved evidence alone.
ORIGIN_TRACE=true
GOOGLE_FACTCHECK_API_KEY=...
ORIGIN_MAX_CLAIMS=5             # fact-check lookups per article
FACTCHECK_MIN_RELEVANCE=0.6     # how closely a fact-check must match the claim
# Search beyond trusted outlets for where the claim appeared (keyless Google News
# RSS; SerpAPI/Tavily too when keyed). False claims usually start on low-trust sites.
ORIGIN_WIDE_SEARCH=true
ORIGIN_SEARCH_COUNTRY=IN        # Google News edition for claims with no place

# ── macOS: torch + XGBoost/LightGBM ───────────────────────────────────────────
# Torch runs on one thread by default; see paper_trail_core/nlp/openmp.py.
# TORCH_NUM_THREADS is read from the shell environment, not from this file, and
# should only be raised when the process is started with a single OpenMP
# runtime (DYLD_LIBRARY_PATH=/opt/homebrew/opt/libomp/lib — see the README).
